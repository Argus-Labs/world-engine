#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
local_bin="$HOME/.local/bin"
go_version="$(awk '$1 == "go" { print $2; exit }' "$repo_root/go.mod")"
moon_version="$(awk -F '"' '/^moon =/ { print $2; exit }' "$repo_root/.prototools")"
# Keep protobuf generation reproducible without changing the checked-in clients.
buf_version="1.75.0"
protoc_go_version="1.36.11"
protoc_connect_version="1.21.1"

cd "$repo_root"
setup_start=$SECONDS
download_dir="$(mktemp -d)"
trap 'rm -rf "$download_dir"' EXIT

mkdir -p "$local_bin" "$HOME/.local/share/go"
export PATH="$local_bin:$PATH"

profile_marker="# world-engine orb tools"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
	cat >> "$HOME/.bash_profile" <<'EOF'

# world-engine orb tools
case ":$PATH:" in
	*":$HOME/.local/bin:"*) ;;
	*) export PATH="$HOME/.local/bin:$PATH" ;;
esac
EOF
fi

missing_packages=()
for package in build-essential ca-certificates curl git tar xz-utils; do
	if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != "install ok installed" ]]; then
		missing_packages+=("$package")
	fi
done
if ((${#missing_packages[@]})); then
	echo "Installing system build prerequisites: ${missing_packages[*]}..."
	sudo apt-get update
	time sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing_packages[@]}"
fi

case "$(uname -m)" in
	x86_64) go_arch="amd64"; moon_arch="x86_64"; buf_arch="x86_64" ;;
	aarch64 | arm64) go_arch="arm64"; moon_arch="aarch64"; buf_arch="aarch64" ;;
	*) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

go_dir="$HOME/.local/share/go/$go_version"
if [[ ! -x "$go_dir/bin/go" ]]; then
	echo "Installing Go ${go_version}..."
	time curl -fsSL "https://go.dev/dl/go${go_version}.linux-${go_arch}.tar.gz" -o "$download_dir/go.tar.gz"
	mkdir -p "$go_dir"
	time tar -xzf "$download_dir/go.tar.gz" --strip-components=1 -C "$go_dir"
fi
# Reactivate a cached version even when another Go is already on PATH.
ln -sfn "$go_dir/bin/go" "$local_bin/go"
ln -sfn "$go_dir/bin/gofmt" "$local_bin/gofmt"

go env -w GOBIN="$local_bin"

echo "Installing repository tools..."
if [[ "$(moon --version 2>/dev/null || true)" != "moon $moon_version" ]]; then
	time curl -fsSL "https://github.com/moonrepo/moon/releases/download/v${moon_version}/moon_cli-${moon_arch}-unknown-linux-gnu.tar.xz" -o "$download_dir/moon.tar.xz"
	tar -xJf "$download_dir/moon.tar.xz" -C "$download_dir"
	install -m 755 "$download_dir/moon_cli-${moon_arch}-unknown-linux-gnu/moon" "$local_bin/moon"
fi
if [[ "$(buf --version 2>/dev/null || true)" != "$buf_version" ]]; then
	# Buf publishes a binary; avoid compiling its large dependency graph during setup.
	time curl -fsSL "https://github.com/bufbuild/buf/releases/download/v${buf_version}/buf-Linux-${buf_arch}" -o "$download_dir/buf"
	install -m 755 "$download_dir/buf" "$local_bin/buf"
fi
if [[ "$(protoc-gen-go --version 2>/dev/null || true)" != "protoc-gen-go v$protoc_go_version" ]]; then
	time go install "google.golang.org/protobuf/cmd/protoc-gen-go@v$protoc_go_version"
fi
if [[ "$(protoc-gen-connect-go --version 2>/dev/null || true)" != "$protoc_connect_version" ]]; then
	time go install "connectrpc.com/connect/cmd/protoc-gen-connect-go@v$protoc_connect_version"
fi

echo "Downloading Go module dependencies..."
time go mod download

echo "Orb setup complete in $((SECONDS - setup_start))s: $(go version), $(moon --version)"
