{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "database"
  ],
  "properties": {
    "global": {
      "type": "object"
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "user": {
      "type": "string",
      "minLength": 1
    },
    "password": {
      "type": "string"
    },
    "database": {
      "type": "string",
      "minLength": 1
    },
    "storage": {
      "type": "string",
      "pattern": "^[0-9]+(Mi|Gi)$"
    },
    "resources": {
      "type": "object"
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "nodePort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32767
        }
      }
    }
  }
}
